generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum SubscriptionPlan {
  BASIC
  PREMIUM
  VIP
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BoostStatus {
  ACTIVE
  EXPIRED
}

enum SafetyCheckinStatus {
  PENDING
  CONFIRMED
  MISSED
  ESCALATED
}

enum PanicAlertStatus {
  ACTIVE
  RESOLVED
  FALSE_ALARM
}

enum KycLevel {
  NONE
  EMAIL
  DOCUMENT
  BIOMETRIC
  FULL
}

enum ContentType {
  PHOTO
  VIDEO
  AUDIO
}

enum BoostType {
  STANDARD // 24h, R$50
  PREMIUM // 7d, R$200
  ULTRA // 30d, R$700
}

enum ProSubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  EXPIRED
}

// ─── USERS ───────────────────────────────────

model User {
  id             String    @id @default(cuid())
  email          String    @unique
  passwordHash   String?
  name           String
  phone          String?
  avatar         String?
  role           UserRole  @default(CLIENT)
  emailVerified  Boolean   @default(false)
  mfaEnabled     Boolean   @default(false)
  mfaSecret      String?
  mfaBackupCodes String[]  @default([])
  banned         Boolean   @default(false)
  bannedReason   String?
  lastLoginAt    DateTime?
  googleId       String?   @unique
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  professional      Professional?
  client            Client?
  sessions          Session[]
  notifications     Notification[]
  auditLogs         AuditLog[]
  emergencyContacts EmergencyContact[]
  panicAlerts       PanicAlert[]
  loginAttempts     LoginAttempt[]

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  device    String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ─── PROFESSIONAL ────────────────────────────

model Professional {
  id                 String    @id @default(cuid())
  userId             String    @unique
  slug               String    @unique
  tagline            String?
  description        String?   @db.Text
  age                Int?
  city               String
  state              String
  country            String    @default("BR")
  lat                Float?
  lng                Float?
  verified           Boolean   @default(false)
  premium            Boolean   @default(false)
  online             Boolean   @default(false)
  active             Boolean   @default(true)
  profileComplete    Boolean   @default(false)
  pricePerHour       Float?
  kycStatus          KycStatus @default(PENDING)
  kycLevel           KycLevel  @default(NONE)
  kycDocuments       Json?
  kycSelfieUrl       String?
  kycDocumentUrl     String?
  kycSubmittedAt     DateTime?
  kycReviewedAt      DateTime?
  kycReviewerId      String?
  kycRejectionReason String?
  stripeAccountId    String?   @unique
  rating             Float     @default(0)
  reviewCount        Int       @default(0)
  viewCount          Int       @default(0)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  // ─── MONETIZATION FIELDS ────────────────────
  monthlySubscriptionPrice Float? // for individual subscription tier (like OnlyFans)
  subscriptionEnabled      Boolean @default(false)
  totalEarnings            Float   @default(0)
  totalTipsReceived        Float   @default(0)
  subscriberCount          Int     @default(0)

  user           User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos         Photo[]
  categories     ProfessionalCategory[]
  languages      ProfessionalLanguage[]
  services       ProfessionalService[]
  availability   Availability[]
  bookings       Booking[]
  reviews        Review[]
  boosts         Boost[]
  earnings       Earning[]
  safetyCheckins SafetyCheckin[]
  clientReviews  ClientReview[]
  blockedClients BlockedClient[]
  premiumContent PremiumContent[]
  stories        Story[]
  tipsReceived   Tip[]
  subscribers    ProSubscription[]
  hourPacks      HourPack[]
  travelModes    TravelMode[]

  @@index([city])
  @@index([verified])
  @@index([rating])
  @@index([pricePerHour])
  @@index([kycLevel])
  @@index([subscriptionEnabled])
}

model Photo {
  id             String   @id @default(cuid())
  professionalId String
  url            String
  thumbnailUrl   String?
  order          Int      @default(0)
  approved       Boolean  @default(false)
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
}

model Availability {
  id             String @id @default(cuid())
  professionalId String
  dayOfWeek      Int
  startTime      String
  endTime        String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
}

model ProfessionalCategory {
  id             String @id @default(cuid())
  professionalId String
  name           String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model ProfessionalLanguage {
  id             String @id @default(cuid())
  professionalId String
  language       String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model ProfessionalService {
  id             String @id @default(cuid())
  professionalId String
  name           String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model Boost {
  id              String      @id @default(cuid())
  professionalId  String
  type            BoostType   @default(STANDARD)
  status          BoostStatus @default(ACTIVE)
  startsAt        DateTime    @default(now())
  endsAt          DateTime
  paidAmount      Float
  multiplier      Float       @default(2.0) // search ranking multiplier
  stripePaymentId String?
  createdAt       DateTime    @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
  @@index([status, endsAt])
  @@index([type])
}

// ─── CLIENT ──────────────────────────────────

model Client {
  id                    String   @id @default(cuid())
  userId                String   @unique
  credits               Int      @default(0)
  balance               Float    @default(0)
  cashback              Float    @default(0)
  stripeCustomerId      String?  @unique
  reputationScore       Float    @default(0)
  completedBookings     Int      @default(0)
  cancelledBookings     Int      @default(0)
  noShowCount           Int      @default(0)
  averageRatingFromPros Float    @default(0)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings          Booking[]
  reviews           Review[]
  subscription      Subscription?
  preferences       ClientPreference?
  favorites         Favorite[]
  transactions      Transaction[]
  clientReviews     ClientReview[]
  blockedBy         BlockedClient[]
  contentUnlocks    ContentUnlock[]
  tipsSent          Tip[]
  proSubscriptions  ProSubscription[]
  storyViews        StoryView[]
  hourPackPurchases HourPackPurchase[]

  @@index([reputationScore])
}

model Favorite {
  id             String   @id @default(cuid())
  clientId       String
  professionalId String
  createdAt      DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, professionalId])
}

// ─── SUBSCRIPTIONS ───────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  clientId             String             @unique
  plan                 SubscriptionPlan
  status               SubscriptionStatus @default(ACTIVE)
  creditsPerCycle      Int
  creditsUsed          Int                @default(0)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ─── BOOKINGS ────────────────────────────────

model Booking {
  id                    String        @id @default(cuid())
  clientId              String
  professionalId        String
  date                  DateTime
  startTime             String
  endTime               String
  durationHours         Float
  location              String?
  notes                 String?       @db.Text
  status                BookingStatus @default(PENDING)
  paymentStatus         PaymentStatus @default(PENDING)
  totalAmount           Float
  platformFeePercent    Float         @default(15)
  platformFeeAmount     Float
  professionalAmount    Float
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?
  payoutAt              DateTime?
  cancelledAt           DateTime?
  cancelledBy           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  client         Client          @relation(fields: [clientId], references: [id])
  professional   Professional    @relation(fields: [professionalId], references: [id])
  review         Review?
  clientReview   ClientReview?
  messages       Message[]
  safetyCheckins SafetyCheckin[]

  @@index([clientId])
  @@index([professionalId])
  @@index([status])
  @@index([date])
}

// ─── REVIEWS ─────────────────────────────────

model Review {
  id             String    @id @default(cuid())
  bookingId      String    @unique
  clientId       String
  professionalId String
  rating         Int
  comment        String?   @db.Text
  replyComment   String?   @db.Text
  repliedAt      DateTime?
  createdAt      DateTime  @default(now())

  booking      Booking      @relation(fields: [bookingId], references: [id])
  client       Client       @relation(fields: [clientId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])

  @@index([professionalId])
}

// ─── FINANCIALS ──────────────────────────────

model Transaction {
  id          String   @id @default(cuid())
  clientId    String
  amount      Float
  type        String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId])
}

model Earning {
  id             String    @id @default(cuid())
  professionalId String
  bookingId      String?
  amount         Float
  status         String    @default("pending")
  paidOutAt      DateTime?
  createdAt      DateTime  @default(now())

  professional Professional @relation(fields: [professionalId], references: [id])

  @@index([professionalId])
  @@index([status])
}

// ─── CHAT ────────────────────────────────────

model Conversation {
  id             String    @id @default(cuid())
  clientId       String
  professionalId String
  lastMessageAt  DateTime?
  createdAt      DateTime  @default(now())

  messages Message[]

  @@unique([clientId, professionalId])
  @@index([clientId])
  @@index([professionalId])
}

model Message {
  id             String    @id @default(cuid())
  conversationId String
  senderId       String
  bookingId      String?
  content        String    @db.Text
  contentType    String    @default("text")
  read           Boolean   @default(false)
  readAt         DateTime?
  expiresAt      DateTime?
  deleted        Boolean   @default(false)
  deletedAt      DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  booking      Booking?     @relation(fields: [bookingId], references: [id])

  @@index([conversationId])
  @@index([senderId])
  @@index([expiresAt])
}

// ─── SYSTEM ──────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String
  read      Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model WebhookEvent {
  id          String    @id @default(cuid())
  provider    String
  eventId     String    @unique
  eventType   String
  payload     Json
  processed   Boolean   @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@index([eventId])
  @@index([processed])
}

// ─── SAFETY & TRUST ──────────────────────────

model EmergencyContact {
  id           String   @id @default(cuid())
  userId       String
  name         String
  phone        String
  email        String?
  relationship String?
  isPrimary    Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model SafetyCheckin {
  id              String              @id @default(cuid())
  professionalId  String
  bookingId       String?
  status          SafetyCheckinStatus @default(PENDING)
  expectedAt      DateTime
  confirmedAt     DateTime?
  lat             Float?
  lng             Float?
  notes           String?
  escalatedAt     DateTime?
  escalationLevel Int                 @default(0)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  booking      Booking?     @relation(fields: [bookingId], references: [id])

  @@index([professionalId])
  @@index([bookingId])
  @@index([status, expectedAt])
}

model PanicAlert {
  id               String           @id @default(cuid())
  userId           String
  bookingId        String?
  status           PanicAlertStatus @default(ACTIVE)
  triggeredAt      DateTime         @default(now())
  resolvedAt       DateTime?
  lat              Float?
  lng              Float?
  accuracy         Float?
  message          String?          @db.Text
  contactsNotified Json?
  audioUrl         String?
  resolution       String?
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
}

model ClientReview {
  id             String   @id @default(cuid())
  bookingId      String   @unique
  clientId       String
  professionalId String
  rating         Int
  punctuality    Int?
  respectful     Boolean  @default(true)
  paidOnTime     Boolean  @default(true)
  comment        String?  @db.Text
  isPrivate      Boolean  @default(true)
  createdAt      DateTime @default(now())

  booking      Booking      @relation(fields: [bookingId], references: [id])
  client       Client       @relation(fields: [clientId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])

  @@index([clientId])
  @@index([professionalId])
}

model BlockedClient {
  id             String   @id @default(cuid())
  professionalId String
  clientId       String
  reason         String?
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([professionalId, clientId])
  @@index([professionalId])
  @@index([clientId])
}

model VerificationCode {
  id        String   @id @default(cuid())
  email     String
  codeHash  String
  purpose   String // 'REGISTER' | 'PASSWORD_RESET' | 'EMAIL_CHANGE'
  attempts  Int      @default(0)
  used      Boolean  @default(false)
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([email, purpose, used])
  @@index([expiresAt])
}

model LoginAttempt {
  id         String   @id @default(cuid())
  userId     String?
  email      String
  ip         String?
  userAgent  String?
  success    Boolean
  failReason String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([email, createdAt])
  @@index([ip, createdAt])
}

// ─── MONETIZATION ────────────────────────────

model PremiumContent {
  id              String      @id @default(cuid())
  professionalId  String
  type            ContentType
  url             String
  thumbnailUrl    String?
  blurUrl         String?
  title           String?
  description     String?     @db.Text
  price           Float
  durationSeconds Int?
  visible         Boolean     @default(true)
  unlockCount     Int         @default(0)
  totalRevenue    Float       @default(0)
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  professional Professional    @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  unlocks      ContentUnlock[]

  @@index([professionalId])
  @@index([visible, createdAt])
}

model ContentUnlock {
  id                    String   @id @default(cuid())
  contentId             String
  clientId              String
  amount                Float
  platformFeeAmount     Float
  professionalAmount    Float
  stripePaymentIntentId String?
  createdAt             DateTime @default(now())

  content PremiumContent @relation(fields: [contentId], references: [id], onDelete: Cascade)
  client  Client         @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([contentId, clientId])
  @@index([clientId])
  @@index([contentId])
}

model Tip {
  id                    String   @id @default(cuid())
  clientId              String
  professionalId        String
  amount                Float
  platformFeeAmount     Float
  professionalAmount    Float
  message               String?
  isPublic              Boolean  @default(true)
  stripePaymentIntentId String?  @unique
  createdAt             DateTime @default(now())

  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([professionalId, createdAt])
}

model ProSubscription {
  id                   String                @id @default(cuid())
  clientId             String
  professionalId       String
  monthlyPrice         Float
  status               ProSubscriptionStatus @default(ACTIVE)
  startedAt            DateTime              @default(now())
  currentPeriodStart   DateTime              @default(now())
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean               @default(false)
  cancelledAt          DateTime?
  stripeSubscriptionId String?               @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt

  client       Client       @relation(fields: [clientId], references: [id], onDelete: Cascade)
  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@unique([clientId, professionalId])
  @@index([clientId, status])
  @@index([professionalId, status])
}

model Story {
  id              String      @id @default(cuid())
  professionalId  String
  type            ContentType @default(PHOTO)
  url             String
  thumbnailUrl    String?
  caption         String?
  subscribersOnly Boolean     @default(false)
  viewCount       Int         @default(0)
  expiresAt       DateTime
  createdAt       DateTime    @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  views        StoryView[]

  @@index([professionalId])
  @@index([expiresAt])
}

model StoryView {
  id       String   @id @default(cuid())
  storyId  String
  userId   String
  viewedAt DateTime @default(now())

  story  Story  @relation(fields: [storyId], references: [id], onDelete: Cascade)
  client Client @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([storyId, userId])
  @@index([userId])
}

model HourPack {
  id             String   @id @default(cuid())
  professionalId String
  hours          Int
  pricePerHour   Float
  totalPrice     Float
  discountPct    Float
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  professional Professional       @relation(fields: [professionalId], references: [id], onDelete: Cascade)
  purchases    HourPackPurchase[]

  @@index([professionalId, active])
}

model HourPackPurchase {
  id                    String    @id @default(cuid())
  packId                String
  clientId              String
  professionalId        String
  hoursRemaining        Float
  totalHours            Int
  amountPaid            Float
  platformFeeAmount     Float
  professionalAmount    Float
  expiresAt             DateTime?
  stripePaymentIntentId String?
  createdAt             DateTime  @default(now())

  pack   HourPack @relation(fields: [packId], references: [id])
  client Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId])
  @@index([professionalId])
}

// ─── DISCOVERY & MATCHING ────────────────────

model ClientPreference {
  id                  String   @id @default(cuid())
  clientId            String   @unique
  ageMin              Int?
  ageMax              Int?
  preferredCities     String[] @default([])
  preferredCategories String[] @default([])
  preferredLanguages  String[] @default([])
  preferredServices   String[] @default([])
  maxPricePerHour     Float?
  minRating           Float?
  onlyVerified        Boolean  @default(false)
  preferOnline        Boolean  @default(false)
  updatedAt           DateTime @updatedAt
  createdAt           DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model TravelMode {
  id             String   @id @default(cuid())
  professionalId String
  city           String
  state          String
  country        String   @default("BR")
  lat            Float?
  lng            Float?
  startsAt       DateTime
  endsAt         DateTime
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([active, startsAt, endsAt])
  @@index([city])
  @@index([professionalId])
}
