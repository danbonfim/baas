generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CLIENT
  PROFESSIONAL
  ADMIN
}

enum BookingStatus {
  PENDING
  CONFIRMED
  COMPLETED
  CANCELLED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  PAID
  REFUNDED
  FAILED
}

enum SubscriptionPlan {
  BASIC
  PREMIUM
  VIP
}

enum SubscriptionStatus {
  ACTIVE
  CANCELLED
  PAST_DUE
  TRIALING
}

enum KycStatus {
  PENDING
  APPROVED
  REJECTED
}

enum BoostStatus {
  ACTIVE
  EXPIRED
}

// ─── USERS ───────────────────────────────────

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String?
  name         String
  phone        String?
  avatar       String?
  role         UserRole  @default(CLIENT)
  emailVerified Boolean  @default(false)
  mfaEnabled   Boolean   @default(false)
  mfaSecret    String?
  banned       Boolean   @default(false)
  bannedReason String?
  lastLoginAt  DateTime?
  googleId     String?   @unique
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  professional  Professional?
  client        Client?
  sessions      Session[]
  notifications Notification[]
  auditLogs     AuditLog[]

  @@index([email])
  @@index([role])
}

model Session {
  id        String   @id @default(cuid())
  userId    String
  token     String   @unique
  device    String?
  ip        String?
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
}

// ─── PROFESSIONAL ────────────────────────────

model Professional {
  id               String    @id @default(cuid())
  userId           String    @unique
  slug             String    @unique
  tagline          String?
  description      String?   @db.Text
  age              Int?
  city             String
  state            String
  country          String    @default("BR")
  lat              Float?
  lng              Float?
  verified         Boolean   @default(false)
  premium          Boolean   @default(false)
  online           Boolean   @default(false)
  active           Boolean   @default(true)
  profileComplete  Boolean   @default(false)
  pricePerHour     Float?
  kycStatus        KycStatus @default(PENDING)
  kycDocuments     Json?
  stripeAccountId  String?   @unique
  rating           Float     @default(0)
  reviewCount      Int       @default(0)
  viewCount        Int       @default(0)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user         User                   @relation(fields: [userId], references: [id], onDelete: Cascade)
  photos       Photo[]
  categories   ProfessionalCategory[]
  languages    ProfessionalLanguage[]
  services     ProfessionalService[]
  availability Availability[]
  bookings     Booking[]
  reviews      Review[]
  boosts       Boost[]
  earnings     Earning[]

  @@index([city])
  @@index([verified])
  @@index([rating])
  @@index([pricePerHour])
}

model Photo {
  id             String   @id @default(cuid())
  professionalId String
  url            String
  thumbnailUrl   String?
  order          Int      @default(0)
  approved       Boolean  @default(false)
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
}

model Availability {
  id             String @id @default(cuid())
  professionalId String
  dayOfWeek      Int
  startTime      String
  endTime        String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)

  @@index([professionalId])
}

model ProfessionalCategory {
  id             String @id @default(cuid())
  professionalId String
  name           String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model ProfessionalLanguage {
  id             String @id @default(cuid())
  professionalId String
  language       String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model ProfessionalService {
  id             String @id @default(cuid())
  professionalId String
  name           String

  professional Professional @relation(fields: [professionalId], references: [id], onDelete: Cascade)
}

model Boost {
  id              String      @id @default(cuid())
  professionalId  String
  status          BoostStatus @default(ACTIVE)
  endsAt          DateTime
  paidAmount      Float
  stripePaymentId String?
  createdAt       DateTime    @default(now())

  professional Professional @relation(fields: [professionalId], references: [id])

  @@index([professionalId])
  @@index([status, endsAt])
}

// ─── CLIENT ──────────────────────────────────

model Client {
  id               String  @id @default(cuid())
  userId           String  @unique
  credits          Int     @default(0)
  balance          Float   @default(0)
  cashback         Float   @default(0)
  stripeCustomerId String? @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  bookings     Booking[]
  reviews      Review[]
  subscription Subscription?
  favorites    Favorite[]
  transactions Transaction[]
}

model Favorite {
  id             String   @id @default(cuid())
  clientId       String
  professionalId String
  createdAt      DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@unique([clientId, professionalId])
}

// ─── SUBSCRIPTIONS ───────────────────────────

model Subscription {
  id                   String             @id @default(cuid())
  clientId             String             @unique
  plan                 SubscriptionPlan
  status               SubscriptionStatus @default(ACTIVE)
  creditsPerCycle      Int
  creditsUsed          Int                @default(0)
  currentPeriodStart   DateTime
  currentPeriodEnd     DateTime
  cancelAtPeriodEnd    Boolean            @default(false)
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  client Client @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([status])
}

// ─── BOOKINGS ────────────────────────────────

model Booking {
  id                    String        @id @default(cuid())
  clientId              String
  professionalId        String
  date                  DateTime
  startTime             String
  endTime               String
  durationHours         Float
  location              String?
  notes                 String?       @db.Text
  status                BookingStatus @default(PENDING)
  paymentStatus         PaymentStatus @default(PENDING)
  totalAmount           Float
  platformFeePercent    Float         @default(15)
  platformFeeAmount     Float
  professionalAmount    Float
  stripePaymentIntentId String?       @unique
  stripeChargeId        String?
  payoutAt              DateTime?
  cancelledAt           DateTime?
  cancelledBy           String?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt

  client       Client       @relation(fields: [clientId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])
  review       Review?
  messages     Message[]

  @@index([clientId])
  @@index([professionalId])
  @@index([status])
  @@index([date])
}

// ─── REVIEWS ─────────────────────────────────

model Review {
  id             String   @id @default(cuid())
  bookingId      String   @unique
  clientId       String
  professionalId String
  rating         Int
  comment        String?  @db.Text
  replyComment   String?  @db.Text
  repliedAt      DateTime?
  createdAt      DateTime @default(now())

  booking      Booking      @relation(fields: [bookingId], references: [id])
  client       Client       @relation(fields: [clientId], references: [id])
  professional Professional @relation(fields: [professionalId], references: [id])

  @@index([professionalId])
}

// ─── FINANCIALS ──────────────────────────────

model Transaction {
  id          String   @id @default(cuid())
  clientId    String
  amount      Float
  type        String
  description String?
  metadata    Json?
  createdAt   DateTime @default(now())

  client Client @relation(fields: [clientId], references: [id])

  @@index([clientId])
}

model Earning {
  id             String   @id @default(cuid())
  professionalId String
  bookingId      String?
  amount         Float
  status         String   @default("pending")
  paidOutAt      DateTime?
  createdAt      DateTime @default(now())

  professional Professional @relation(fields: [professionalId], references: [id])

  @@index([professionalId])
  @@index([status])
}

// ─── CHAT ────────────────────────────────────

model Conversation {
  id             String    @id @default(cuid())
  clientId       String
  professionalId String
  lastMessageAt  DateTime?
  createdAt      DateTime  @default(now())

  messages Message[]

  @@unique([clientId, professionalId])
  @@index([clientId])
  @@index([professionalId])
}

model Message {
  id             String   @id @default(cuid())
  conversationId String
  senderId       String
  bookingId      String?
  content        String   @db.Text
  contentType    String   @default("text")
  read           Boolean  @default(false)
  readAt         DateTime?
  createdAt      DateTime @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  booking      Booking?     @relation(fields: [bookingId], references: [id])

  @@index([conversationId])
  @@index([senderId])
}

// ─── SYSTEM ──────────────────────────────────

model Notification {
  id        String   @id @default(cuid())
  userId    String
  title     String
  body      String
  type      String
  read      Boolean  @default(false)
  data      Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
}

model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  details    Json?
  ip         String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

model WebhookEvent {
  id          String   @id @default(cuid())
  provider    String
  eventId     String   @unique
  eventType   String
  payload     Json
  processed   Boolean  @default(false)
  processedAt DateTime?
  error       String?
  createdAt   DateTime @default(now())

  @@index([eventId])
  @@index([processed])
}
